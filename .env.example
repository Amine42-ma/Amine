# ---------------------------------------------------------------------------
# Dino Royale Evolution - server configuration
# Copy to .env and adjust, or export these directly before `npm start`.
# ---------------------------------------------------------------------------

# HTTP + WebSocket port. The client connects back to whatever host it was
# served from, so this is the only port you need to expose.
PORT=8080

# Listen address. Use 127.0.0.1 when running behind a reverse proxy.
HOST=0.0.0.0

# Where accounts, sessions and clans are persisted (newline-delimited JSON).
# Back this directory up - it is the only stateful part of the server.
DATA_DIR=./data

# Simple abuse guard: maximum simultaneous sockets from a single address.
# Raise it if many players share one NAT (schools, internet cafes).
MAX_CONNECTIONS_PER_IP=12
