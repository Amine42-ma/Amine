# ---------------------------------------------------------------------------
# Dino Royale Evolution - server configuration
# Copy to .env and adjust, or export these directly before `npm start`.
# ---------------------------------------------------------------------------

# HTTP + WebSocket port. The client connects back to whatever host it was
# served from, so this is the only port you need to expose.
PORT=8080

# Listen address. Use 127.0.0.1 when running behind a reverse proxy.
HOST=0.0.0.0

# Where accounts, sessions and clans are persisted (newline-delimited JSON).
# Back this directory up - it is the only stateful part of the server.
DATA_DIR=./data

# Simple abuse guard: maximum simultaneous sockets from a single address.
# Raise it if many players share one NAT (schools, internet cafes).
MAX_CONNECTIONS_PER_IP=12

# ---------------------------------------------------------------------------
# Social sign-in (optional)
# ---------------------------------------------------------------------------
# Leave these empty and the Google / Facebook buttons simply do not appear.
# The game works fully with name + password alone.
#
# Google:   https://console.cloud.google.com/apis/credentials
#   Create an "OAuth client ID" of type "Web application" and add this exact
#   redirect URI:   <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook: https://developers.facebook.com/apps
#   Add the "Facebook Login" product and set the redirect URI to:
#                   <PUBLIC_URL>/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# The public address players reach the game on. Required for social sign-in
# because the provider must be given an exact, absolute redirect URI.
# Example: https://dino.example.com   (no trailing slash)
PUBLIC_URL=

# Secret used to sign OAuth state parameters. A random one is generated at
# boot if unset, which invalidates in-flight sign-ins on restart - set it in
# production so restarts are seamless.
SESSION_SECRET=
