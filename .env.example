# ─────────────────────────────────────────────────────────────
# AI Film Studio — configuration
# Everything works with NO keys (offline cinematic engine).
# Add keys to upgrade each stage to real AI generation.
# Copy to `.env` and fill what you have. Load with your process
# manager, or: `node --env-file=.env server.js`
# ─────────────────────────────────────────────────────────────

PORT=8787

# ---- Screenwriter (turns your story into a full production plan) ----
# With this, Claude writes the screenplay; without it, the built-in
# offline writer is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ---- Video generation ----
# VIDEO_PROVIDER: auto | cinematic | fal | replicate
#   auto      → use a real provider if its key is set, else cinematic
#   cinematic → always use the offline engine (no keys needed)
VIDEO_PROVIDER=auto
FAL_KEY=
FAL_VIDEO_MODEL=fal-ai/ltx-video
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=

# ---- Narration / voice ----
# VOICE_PROVIDER: auto | silent | elevenlabs | openai
#   silent → narration shown as burned-in subtitles only (no keys)
VOICE_PROVIDER=auto
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
OPENAI_API_KEY=
OPENAI_TTS_VOICE=onyx
OPENAI_TTS_MODEL=tts-1-hd
